# Telegram Bot Token (получить у @BotFather)
TELEGRAM_TOKEN= 

# ProxyAPI ключ (https://proxyapi.ru)
OPENAI_API_KEY=sk-proj-1234567890

# ProxyAPI базовый URL — не менять
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# MCP Server (локальный — прокси не нужен)
MCP_SERVER_URL=http://localhost:8000

# Karing SOCKS5 прокси
# Стандартный порт Karing — 2080, проверь в настройках приложения
SOCKS5_PROXY=socks5://127.0.0.1:3067
